# Parity: playback. Generated by tests/parity/gen/record.py from a real Jellyfin;
# do not edit by hand, edit REQUESTS and regenerate.
# Variables: base_url, token, user_id.

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Movie
HTTP 200
[Captures]
movie_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Series
HTTP 200
[Captures]
series_id: jsonpath "$.Items[0].Id"

POST {{base_url}}/Items/{{movie_id}}/PlaybackInfo
Authorization: MediaBrowser Token="{{token}}"
Content-Type: application/json
[QueryStringParams]
UserId: {{user_id}}
{}
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.MediaSources" isCollection
jsonpath "$.MediaSources[0].Protocol" isString
