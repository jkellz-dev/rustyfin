jsonpath "$.Policy.EnableVideoPlaybackTranscoding" isBoolean
jsonpath "$.Policy.EnablePlaybackRemuxing" isBoolean
jsonpath "$.Policy.ForceRemoteSourceTranscoding" isBoolean
