# Parity: users. Generated by tests/parity/gen/record.py from a real Jellyfin;
# do not edit by hand, edit REQUESTS and regenerate.
# Variables: base_url, token, user_id.

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Movie
HTTP 200
[Captures]
movie_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Series
HTTP 200
[Captures]
series_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Users/Me
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Name" isString
jsonpath "$.ServerId" isString
jsonpath "$.Id" isString
jsonpath "$.HasPassword" isBoolean
jsonpath "$.HasConfiguredPassword" isBoolean
jsonpath "$.HasConfiguredEasyPassword" isBoolean
jsonpath "$.EnableAutoLogin" isBoolean
jsonpath "$.LastLoginDate" isString
jsonpath "$.LastActivityDate" isString
jsonpath "$.Configuration" exists
jsonpath "$.Configuration.PlayDefaultAudioTrack" isBoolean
jsonpath "$.Configuration.SubtitleLanguagePreference" isString
jsonpath "$.Configuration.DisplayMissingEpisodes" isBoolean
jsonpath "$.Configuration.GroupedFolders" isCollection
jsonpath "$.Configuration.SubtitleMode" isString
jsonpath "$.Configuration.DisplayCollectionsView" isBoolean
jsonpath "$.Configuration.EnableLocalPassword" isBoolean
jsonpath "$.Configuration.OrderedViews" isCollection
jsonpath "$.Configuration.LatestItemsExcludes" isCollection
jsonpath "$.Configuration.MyMediaExcludes" isCollection
jsonpath "$.Configuration.HidePlayedInLatest" isBoolean
jsonpath "$.Configuration.RememberAudioSelections" isBoolean
jsonpath "$.Configuration.RememberSubtitleSelections" isBoolean
jsonpath "$.Configuration.EnableNextEpisodeAutoPlay" isBoolean
jsonpath "$.Configuration.CastReceiverId" isString
jsonpath "$.Policy" exists
jsonpath "$.Policy.IsAdministrator" isBoolean
jsonpath "$.Policy.IsHidden" isBoolean
jsonpath "$.Policy.EnableCollectionManagement" isBoolean
jsonpath "$.Policy.EnableSubtitleManagement" isBoolean
jsonpath "$.Policy.EnableLyricManagement" isBoolean
jsonpath "$.Policy.IsDisabled" isBoolean
jsonpath "$.Policy.BlockedTags" isCollection
jsonpath "$.Policy.AllowedTags" isCollection
jsonpath "$.Policy.EnableUserPreferenceAccess" isBoolean
jsonpath "$.Policy.AccessSchedules" isCollection
jsonpath "$.Policy.BlockUnratedItems" isCollection
jsonpath "$.Policy.EnableRemoteControlOfOtherUsers" isBoolean
jsonpath "$.Policy.EnableSharedDeviceControl" isBoolean
jsonpath "$.Policy.EnableRemoteAccess" isBoolean
jsonpath "$.Policy.EnableLiveTvManagement" isBoolean
jsonpath "$.Policy.EnableLiveTvAccess" isBoolean
jsonpath "$.Policy.EnableMediaPlayback" isBoolean
