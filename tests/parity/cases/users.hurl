jsonpath "$.Policy.EnableAllDevices" isBoolean
jsonpath "$.Policy.EnabledChannels" isCollection
jsonpath "$.Policy.EnableAllChannels" isBoolean
jsonpath "$.Policy.EnabledFolders" isCollection
jsonpath "$.Policy.EnableAllFolders" isBoolean
jsonpath "$.Policy.InvalidLoginAttemptCount" isInteger
jsonpath "$.Policy.LoginAttemptsBeforeLockout" isInteger
jsonpath "$.Policy.MaxActiveSessions" isInteger
jsonpath "$.Policy.EnablePublicSharing" isBoolean
