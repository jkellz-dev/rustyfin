GET {{base_url}}/MediaSegments/{{movie_id}}
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Items" isCollection
jsonpath "$.TotalRecordCount" isNumber
jsonpath "$.StartIndex" isNumber

GET {{base_url}}/MediaSegments/{{track_id}}
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Items" isCollection
jsonpath "$.TotalRecordCount" isNumber
jsonpath "$.StartIndex" isNumber

GET {{base_url}}/Audio/{{track_id}}/Lyrics
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Metadata" exists
jsonpath "$.Lyrics" isCollection
jsonpath "$.Lyrics[0].Text" isString
jsonpath "$.Lyrics[0].Start" isNumber

GET {{base_url}}/Audio/{{movie_id}}/Lyrics
Authorization: MediaBrowser Token="{{token}}"
HTTP 404
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.type" isString
jsonpath "$.title" isString
jsonpath "$.status" isNumber
jsonpath "$.traceId" isString
