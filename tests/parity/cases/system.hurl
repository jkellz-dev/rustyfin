# Parity: system. Generated by tests/parity/gen/record.py from a real Jellyfin;
# do not edit by hand, edit REQUESTS and regenerate.
# Variables: base_url, token, user_id.

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Movie
HTTP 200
[Captures]
movie_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Series
HTTP 200
[Captures]
series_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: MusicAlbum
HTTP 200
[Captures]
album_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Artists/AlbumArtists
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Captures]
artist_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/System/Info/Public
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.LocalAddress" isString
jsonpath "$.ServerName" isString
jsonpath "$.Version" isString
jsonpath "$.ProductName" isString
jsonpath "$.OperatingSystem" isString
jsonpath "$.Id" isString
jsonpath "$.StartupWizardCompleted" isBoolean

