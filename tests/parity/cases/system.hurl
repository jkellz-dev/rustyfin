jsonpath "$.LogPath" isString
jsonpath "$.InternalMetadataPath" isString
jsonpath "$.TranscodingTempPath" isString
jsonpath "$.CastReceiverApplications" isCollection
jsonpath "$.CastReceiverApplications[0].Id" isString
jsonpath "$.CastReceiverApplications[0].Name" isString
jsonpath "$.HasUpdateAvailable" isBoolean
jsonpath "$.EncoderLocation" isString
jsonpath "$.SystemArchitecture" isString
jsonpath "$.LocalAddress" isString
jsonpath "$.ServerName" isString
jsonpath "$.Version" isString
jsonpath "$.OperatingSystem" isString
jsonpath "$.Id" isString

GET {{base_url}}/System/Ping
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"

GET {{base_url}}/GetUtcTime
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.RequestReceptionTime" isString
jsonpath "$.ResponseTransmissionTime" isString

GET {{base_url}}/Branding/Configuration
HTTP 200
[Asserts]
