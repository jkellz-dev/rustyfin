# Parity: system. Generated by tests/parity/gen/record.py from a real Jellyfin;
# do not edit by hand, edit REQUESTS and regenerate.
# Variables: base_url, token, user_id.

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Movie
HTTP 200
[Captures]
movie_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Series
HTTP 200
[Captures]
series_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: MusicAlbum
HTTP 200
[Captures]
album_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Artists/AlbumArtists
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Captures]
artist_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Library/VirtualFolders
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Captures]
movies_lib_id: jsonpath "$[?(@.CollectionType=='movies')].ItemId"
tv_lib_id: jsonpath "$[?(@.CollectionType=='tvshows')].ItemId"
music_lib_id: jsonpath "$[?(@.CollectionType=='music')].ItemId"

GET {{base_url}}/Shows/{{series_id}}/Seasons
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Captures]
season_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Audio
SortBy: SortName
HTTP 200
[Captures]
track_id: jsonpath "$.Items[0].Id"
GET {{base_url}}/System/Info/Public
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.LocalAddress" isString
jsonpath "$.ServerName" isString
jsonpath "$.Version" isString
jsonpath "$.ProductName" isString
jsonpath "$.OperatingSystem" isString
jsonpath "$.Id" isString
jsonpath "$.StartupWizardCompleted" isBoolean

GET {{base_url}}/System/Info
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.OperatingSystemDisplayName" isString
jsonpath "$.HasPendingRestart" isBoolean
