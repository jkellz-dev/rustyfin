GET {{base_url}}/Studios
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Captures]
studio_name: jsonpath "$.Items[0].Name" urlEncode

GET {{base_url}}/Artists/AlbumArtists
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
