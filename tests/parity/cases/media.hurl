GET {{base_url}}/Items/{{track_id}}/File
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "audio/mpeg"

GET {{base_url}}/Items/{{track_id}}/Download
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "audio/mpeg"

GET {{base_url}}/Items/{{movie_id}}/File
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "video/x-matroska"

GET {{base_url}}/Audio/{{track_id}}/stream
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
static: true
HTTP 200
[Asserts]
header "Content-Type" contains "audio/mpeg"

HEAD {{base_url}}/Audio/{{track_id}}/stream
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
static: true
HTTP 200
[Asserts]
header "Content-Type" contains "audio/mpeg"

GET {{base_url}}/Audio/{{track_id}}/universal
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
UserId: {{user_id}}
Container: mp3,flac,aac,m4a,ogg,opus,wav
TranscodingContainer: mp3
TranscodingProtocol: http
AudioCodec: mp3
HTTP 200
[Asserts]
header "Content-Type" contains "audio/mpeg"

