GET {{base_url}}/System/Configuration
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.EnableMetrics" isBoolean
jsonpath "$.EnableNormalizedItemByNameIds" isBoolean
jsonpath "$.IsPortAuthorized" isBoolean
jsonpath "$.QuickConnectAvailable" isBoolean
jsonpath "$.EnableCaseSensitiveItemIds" isBoolean
jsonpath "$.DisableLiveTvChannelUserDataName" isBoolean
jsonpath "$.MetadataPath" isString
jsonpath "$.PreferredMetadataLanguage" isString
jsonpath "$.MetadataCountryCode" isString
jsonpath "$.SortReplaceCharacters" isCollection
jsonpath "$.SortRemoveCharacters" isCollection
jsonpath "$.SortRemoveWords" isCollection
jsonpath "$.MinResumePct" isNumber
jsonpath "$.MaxResumePct" isNumber
jsonpath "$.MinResumeDurationSeconds" isNumber
jsonpath "$.MinAudiobookResume" isNumber
jsonpath "$.MaxAudiobookResume" isNumber
jsonpath "$.InactiveSessionThreshold" isNumber
jsonpath "$.LibraryMonitorDelay" isNumber
jsonpath "$.LibraryUpdateDuration" isNumber
jsonpath "$.ImageSavingConvention" isString
jsonpath "$.MetadataOptions" isCollection
jsonpath "$.MetadataOptions[0].ItemType" isString
jsonpath "$.MetadataOptions[0].DisabledMetadataSavers" isCollection
jsonpath "$.MetadataOptions[0].LocalMetadataReaderOrder" isCollection
jsonpath "$.MetadataOptions[0].DisabledMetadataFetchers" isCollection
jsonpath "$.MetadataOptions[0].MetadataFetcherOrder" isCollection
jsonpath "$.MetadataOptions[0].DisabledImageFetchers" isCollection
jsonpath "$.MetadataOptions[0].ImageFetcherOrder" isCollection
jsonpath "$.SkipDeserializationForBasicTypes" isBoolean
jsonpath "$.ServerName" isString
jsonpath "$.UICulture" isString
jsonpath "$.SaveMetadataHidden" isBoolean
jsonpath "$.ContentTypes" isCollection
jsonpath "$.RemoteClientBitrateLimit" isNumber
jsonpath "$.EnableFolderView" isBoolean
jsonpath "$.EnableGroupingIntoCollections" isBoolean
jsonpath "$.DisplaySpecialsWithinSeasons" isBoolean
jsonpath "$.CodecsUsed" isCollection
jsonpath "$.PluginRepositories" isCollection
# known difference, not asserted: jsonpath "$.PluginRepositories[0].Name" isString (no plugins (design rule): Rustyfin lists no plugin repository)
# known difference, not asserted: jsonpath "$.PluginRepositories[0].Url" isString (no plugins (design rule): Rustyfin lists no plugin repository)
# known difference, not asserted: jsonpath "$.PluginRepositories[0].Enabled" isBoolean (no plugins (design rule): Rustyfin lists no plugin repository)
jsonpath "$.EnableExternalContentInSuggestions" isBoolean
jsonpath "$.ImageExtractionTimeoutMs" isNumber
jsonpath "$.PathSubstitutions" isCollection
jsonpath "$.EnableSlowResponseWarning" isBoolean
jsonpath "$.SlowResponseThresholdMs" isNumber
jsonpath "$.CorsHosts" isCollection
jsonpath "$.ActivityLogRetentionDays" isNumber
jsonpath "$.LibraryScanFanoutConcurrency" isNumber
jsonpath "$.LibraryMetadataRefreshConcurrency" isNumber
jsonpath "$.RemoveOldPlugins" isBoolean
jsonpath "$.AllowClientLogUpload" isBoolean
jsonpath "$.DummyChapterDuration" isNumber
jsonpath "$.ChapterImageResolution" isString
jsonpath "$.ParallelImageEncodingLimit" isNumber
jsonpath "$.CastReceiverApplications" isCollection
jsonpath "$.CastReceiverApplications[0].Id" isString
jsonpath "$.CastReceiverApplications[0].Name" isString
jsonpath "$.TrickplayOptions" exists
jsonpath "$.TrickplayOptions.EnableHwAcceleration" isBoolean
jsonpath "$.TrickplayOptions.EnableHwEncoding" isBoolean
jsonpath "$.TrickplayOptions.EnableKeyFrameOnlyExtraction" isBoolean
jsonpath "$.TrickplayOptions.ScanBehavior" isString
jsonpath "$.TrickplayOptions.ProcessPriority" isString
jsonpath "$.TrickplayOptions.Interval" isNumber
jsonpath "$.TrickplayOptions.WidthResolutions" isCollection
jsonpath "$.TrickplayOptions.TileWidth" isNumber
jsonpath "$.TrickplayOptions.TileHeight" isNumber
jsonpath "$.TrickplayOptions.Qscale" isNumber
jsonpath "$.TrickplayOptions.JpegQuality" isNumber
jsonpath "$.TrickplayOptions.ProcessThreads" isNumber
jsonpath "$.LogFileRetentionDays" isNumber
jsonpath "$.IsStartupWizardCompleted" isBoolean

GET {{base_url}}/System/Configuration/network
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.BaseUrl" isString
jsonpath "$.EnableHttps" isBoolean
jsonpath "$.RequireHttps" isBoolean
jsonpath "$.CertificatePath" isString
jsonpath "$.CertificatePassword" isString
jsonpath "$.InternalHttpPort" isNumber
jsonpath "$.InternalHttpsPort" isNumber
jsonpath "$.PublicHttpPort" isNumber
jsonpath "$.PublicHttpsPort" isNumber
jsonpath "$.AutoDiscovery" isBoolean
jsonpath "$.EnableUPnP" isBoolean
jsonpath "$.EnableIPv4" isBoolean
jsonpath "$.EnableIPv6" isBoolean
jsonpath "$.EnableRemoteAccess" isBoolean
jsonpath "$.LocalNetworkSubnets" isCollection
jsonpath "$.LocalNetworkAddresses" isCollection
jsonpath "$.KnownProxies" isCollection
jsonpath "$.IgnoreVirtualInterfaces" isBoolean
jsonpath "$.VirtualInterfaceNames" isCollection
jsonpath "$.EnablePublishedServerUriByRequest" isBoolean
jsonpath "$.PublishedServerUriBySubnet" isCollection
jsonpath "$.RemoteIPFilter" isCollection
jsonpath "$.IsRemoteIPFilterBlacklist" isBoolean

GET {{base_url}}/System/Configuration/MetadataOptions/Default
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.DisabledMetadataSavers" isCollection
jsonpath "$.LocalMetadataReaderOrder" isCollection
jsonpath "$.DisabledMetadataFetchers" isCollection
jsonpath "$.MetadataFetcherOrder" isCollection
jsonpath "$.DisabledImageFetchers" isCollection
jsonpath "$.ImageFetcherOrder" isCollection

GET {{base_url}}/System/Logs
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$" isCollection
# known difference, not asserted: jsonpath "$[0]" exists (Rustyfin logs to stdout (the container's log), not to log files)
# known difference, not asserted: jsonpath "$[0].DateCreated" isString (Rustyfin logs to stdout (the container's log), not to log files)
# known difference, not asserted: jsonpath "$[0].DateModified" isString (Rustyfin logs to stdout (the container's log), not to log files)
# known difference, not asserted: jsonpath "$[0].Size" isNumber (Rustyfin logs to stdout (the container's log), not to log files)
# known difference, not asserted: jsonpath "$[0].Name" isString (Rustyfin logs to stdout (the container's log), not to log files)

GET {{base_url}}/System/ActivityLog/Entries
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
limit: 5
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Items" isCollection
jsonpath "$.Items[0].Id" isNumber
jsonpath "$.Items[0].Name" isString
# known difference, not asserted: jsonpath "$.Items[0].ShortOverview" isString (the first entry is whatever each server did last (Jellyfin: a sign-in, with its address; Rustyfin: a library change), and those keys are per entry)
jsonpath "$.Items[0].Type" isString
# known difference, not asserted: jsonpath "$.Items[0].ItemId" isString (the first entry is whatever each server did last (Jellyfin: a sign-in, with its address; Rustyfin: a library change), and those keys are per entry)
jsonpath "$.Items[0].Date" isString
jsonpath "$.Items[0].UserId" isString
jsonpath "$.Items[0].Severity" isString
jsonpath "$.TotalRecordCount" isNumber
jsonpath "$.StartIndex" isNumber

GET {{base_url}}/Auth/Keys
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Items" isCollection
jsonpath "$.TotalRecordCount" isNumber
jsonpath "$.StartIndex" isNumber

GET {{base_url}}/Auth/Providers
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$" isCollection
jsonpath "$[0]" exists
jsonpath "$[0].Name" isString
jsonpath "$[0].Id" isString

GET {{base_url}}/Auth/PasswordResetProviders
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$" isCollection
# known difference, not asserted: jsonpath "$[0]" exists (sign-in is forward auth: the server resets no passwords)
# known difference, not asserted: jsonpath "$[0].Name" isString (sign-in is forward auth: the server resets no passwords)
# known difference, not asserted: jsonpath "$[0].Id" isString (sign-in is forward auth: the server resets no passwords)

GET {{base_url}}/Devices
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Items" isCollection
jsonpath "$.Items[0].Name" isString
jsonpath "$.Items[0].Id" isString
jsonpath "$.Items[0].LastUserName" isString
jsonpath "$.Items[0].AppName" isString
jsonpath "$.Items[0].AppVersion" isString
jsonpath "$.Items[0].LastUserId" isString
jsonpath "$.Items[0].DateLastActivity" isString
jsonpath "$.Items[0].Capabilities" exists
jsonpath "$.Items[0].Capabilities.PlayableMediaTypes" isCollection
jsonpath "$.Items[0].Capabilities.SupportedCommands" isCollection
jsonpath "$.Items[0].Capabilities.SupportsMediaControl" isBoolean
jsonpath "$.Items[0].Capabilities.SupportsPersistentIdentifier" isBoolean
jsonpath "$.TotalRecordCount" isNumber
jsonpath "$.StartIndex" isNumber

GET {{base_url}}/Devices/Info
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
id: {{device_id}}
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Name" isString
jsonpath "$.Id" isString
jsonpath "$.LastUserName" isString
jsonpath "$.AppName" isString
jsonpath "$.AppVersion" isString
jsonpath "$.LastUserId" isString
jsonpath "$.DateLastActivity" isString
jsonpath "$.Capabilities" exists
jsonpath "$.Capabilities.PlayableMediaTypes" isCollection
jsonpath "$.Capabilities.SupportedCommands" isCollection
jsonpath "$.Capabilities.SupportsMediaControl" isBoolean
jsonpath "$.Capabilities.SupportsPersistentIdentifier" isBoolean

GET {{base_url}}/ScheduledTasks/{{task_id}}
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.Name" isString
jsonpath "$.State" isString
jsonpath "$.Id" isString
jsonpath "$.LastExecutionResult" exists
jsonpath "$.LastExecutionResult.StartTimeUtc" isString
jsonpath "$.LastExecutionResult.EndTimeUtc" isString
jsonpath "$.LastExecutionResult.Status" isString
jsonpath "$.LastExecutionResult.Name" isString
jsonpath "$.LastExecutionResult.Key" isString
jsonpath "$.LastExecutionResult.Id" isString
jsonpath "$.Triggers" isCollection
jsonpath "$.Triggers[0].Type" isString
# known difference, not asserted: jsonpath "$.Triggers[0].IntervalTicks" isNumber (Rustyfin schedules by cron; a daily scan is a DailyTrigger where Jellyfin's default is a 12-hour interval)
jsonpath "$.Description" isString
jsonpath "$.Category" isString
jsonpath "$.IsHidden" isBoolean
jsonpath "$.Key" isString

