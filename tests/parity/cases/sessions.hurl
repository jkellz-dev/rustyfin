GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Movie
HTTP 200
[Captures]
movie_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Items
Authorization: MediaBrowser Token="{{token}}"
[QueryStringParams]
Recursive: true
IncludeItemTypes: Series
HTTP 200
[Captures]
series_id: jsonpath "$.Items[0].Id"

GET {{base_url}}/Sessions
Authorization: MediaBrowser Token="{{token}}"
HTTP 200
